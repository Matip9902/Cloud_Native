# EC2 #2 - Servicios internos
# Reemplazar por la IP privada de la EC2 #1 donde corre Eureka.
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://REEMPLAZAR_IP_PRIVADA_EC2_ENTRADA:8761/eureka/

# Reemplazar por la IP privada de esta EC2 #2.
SERVICES_EC2_PRIVATE_IP=REEMPLAZAR_IP_PRIVADA_EC2_SERVICIOS

CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_ISSUER_URI=https://login.microsoftonline.com/94b15b07-9bad-4661-8554-aad0e62b18de/v2.0
JWT_AUDIENCES=api://0f18b5b0-285b-4050-a959-245884ab7670,0f18b5b0-285b-4050-a959-245884ab7670

# AWS RDS PostgreSQL compartida por los microservicios.
# Ejemplo de endpoint: cloud-native-db.xxxxxx.us-east-1.rds.amazonaws.com
RDS_JDBC_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/cloud_native
RDS_USERNAME=REEMPLAZAR_USUARIO_RDS
RDS_PASSWORD=REEMPLAZAR_PASSWORD_RDS
RDS_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=update
