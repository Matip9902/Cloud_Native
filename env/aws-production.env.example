# AWS EC2 / ECS / contenedor backend
SERVER_PORT=8080
CUSTOMER_SERVICE_PORT=8081
SUPPLIER_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# AWS RDS PostgreSQL compartida por los microservicios
RDS_JDBC_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/cloud_native
RDS_USERNAME=REEMPLAZAR_USUARIO
RDS_PASSWORD=REEMPLAZAR_PASSWORD
RDS_DRIVER=org.postgresql.Driver

# Opcional: si quieres bases separadas, estas variables sobrescriben RDS_JDBC_URL
# DB_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/inventorydb
# CUSTOMER_DB_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/customerdb
# SUPPLIER_DB_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/supplierdb
# NOTIFICATION_DB_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/notificationdb

# Hibernate
JPA_DDL_AUTO=update

# Azure AD / Microsoft Entra ID
JWT_ISSUER_URI=https://login.microsoftonline.com/94b15b07-9bad-4661-8554-aad0e62b18de/v2.0
JWT_AUDIENCES=api://0f18b5b0-285b-4050-a959-245884ab7670,0f18b5b0-285b-4050-a959-245884ab7670

# Dominio final del frontend Angular publicado
CORS_ALLOWED_ORIGINS=https://REEMPLAZAR_DOMINIO_FRONTEND
